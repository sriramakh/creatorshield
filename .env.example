# CreatorShield AI - configuration template.
#
# Backend:  copy to backend/.env   (read by FastAPI, the worker and Alembic)
# Frontend: NEXT_PUBLIC_API_URL goes in frontend/.env.local
#
# Never commit real keys. backend/.env and frontend/.env.local are git-ignored.

# ---- Core ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://creatorshield:creatorshield_dev@localhost:5432/creatorshield
REDIS_URL=redis://localhost:6379/0
# Set false to run analyses inline in the API process (tests only).
USE_JOB_QUEUE=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- AI inference ----------------------------------------------------------
# anthropic | openai | mock   (mock = clearly labelled placeholder, no AI call)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, more tokens)
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_MAX_OUTPUT_TOKENS=16000

# ---- Speech to text ----------------------------------------------------------
# faster_whisper (local, free) | openai (hosted, paid) | none
STT_PROVIDER=faster_whisper
# tiny | base | small | medium  ("small" ~480 MB, good balance for Hindi on a 16 GB Mac)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# ---- Media processing --------------------------------------------------------
OCR_ENABLED=true
# Frames sent to the AI review: FRAMES_PER_MINUTE of video, kept between
# MIN_FRAMES and MAX_FRAMES (16 for a 1-minute clip, 64 for 16 minutes or more).
MIN_FRAMES=16
MAX_FRAMES=64
FRAMES_PER_MINUTE=4
SCENE_THRESHOLD=0.25
UNIFORM_FRAME_INTERVAL_SECONDS=4.0
# 30 minutes covers 3-minute Shorts, 20-minute Reels and long cuts; 5 GB fits
# 30 minutes of typical phone 4K.
MAX_UPLOAD_MB=5120
MAX_DURATION_SECONDS=1800
# Files above 1080p (short side) or 8 Mbps are re-encoded once to an H.264 1080p
# working copy before analysis; the original is hashed, then deleted. 0 disables.
WORKING_COPY_MAX_SHORT_SIDE=1080
WORKING_COPY_MAX_BITRATE_KBPS=8000
# A 30-minute 4K file can spend ~15 min on its working copy (software decode).
JOB_TIMEOUT_SECONDS=5400

# ---- Retention / privacy -----------------------------------------------------
# Analyses (video, frames, transcript, report) are deleted after this many hours.
RETENTION_HOURS=72
# Delete the video and frames as soon as the analysis completes.
DELETE_MEDIA_AFTER_ANALYSIS=false

# ---- Connected accounts (official APIs only; optional) ---------------------
# Where the browser returns after OAuth, and the public URL of this API.
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Fernet key for encrypting OAuth tokens at rest. scripts/dev.sh generates one.
TOKEN_ENCRYPTION_KEY=

# Instagram API with Instagram Login (Meta developer app, "Instagram" product).
# Add the redirect URI below to the app's valid OAuth redirect URIs (exact match).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Default: {API_PUBLIC_URL}/api/connections/instagram/callback
# If Meta rejects http://localhost, use an HTTPS tunnel URL here and in API_PUBLIC_URL.
INSTAGRAM_REDIRECT_URI=

# YouTube Data API v3 (Google Cloud OAuth client, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default: {API_PUBLIC_URL}/api/connections/youtube/callback
GOOGLE_REDIRECT_URI=
# Reading captions needs youtube.force-ssl ("manage your YouTube account"). Off by default.
YOUTUBE_CAPTIONS_SCOPE=false
# Imported Reels longer than this are trimmed for analysis (first N seconds).
IMPORT_MAX_SECONDS=1800

# ---- Provenance & rights ------------------------------------------------------
# Catalogue fingerprints (frame hashes + Chromaprint audio fingerprint; no media)
# outlive analyses so new videos can be matched against past posts.
CATALOGUE_RETENTION_DAYS=365
CATALOGUE_MAX_SECONDS=3600
FPCALC_CMD=fpcalc

# YouTube look-alike search (official search.list; 100 of 10,000 default daily
# quota units per search). Uses this key, or a connected channel's token if unset.
YOUTUBE_SEARCH_API_KEY=
YOUTUBE_SEARCH_DAILY_UNIT_CAP=3000

# Paid lookups are OFF unless a provider and key are set. All paid calls share
# one monthly budget; a call that would exceed it is skipped, not made.
PAID_LOOKUPS_MONTHLY_BUDGET_USD=5
# Song identification on detected music only: none | audd | mock (mock = labelled placeholder)
MUSIC_ID_PROVIDER=none
AUDD_API_TOKEN=
MUSIC_ID_AUTO=true
# Reverse image search of up to 4 key frames: none | google | mock
WEB_DETECTION_PROVIDER=none
GOOGLE_VISION_API_KEY=
# Runs automatically only when third-party cues are found; otherwise on request.
WEB_DETECTION_AUTO=true

# ---- Frontend (frontend/.env.local) -----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
